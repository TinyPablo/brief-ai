# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Anthropic API key - https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Google AI Studio API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# TOTP secret for Google Authenticator login. Generate one locally with:
#   pip install -r backend/requirements-totp-setup.txt
#   python backend/generate_totp_secret.py
# Scan the printed QR code with your authenticator app, then paste the
# printed secret below. Do NOT generate this on the deploy server.
TOTP_SECRET=CHANGEMECHANGEMECHANGEMECHANGEME

# Secret used to sign session cookies. Use a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to false only for local http testing (cookies otherwise require https)
COOKIE_SECURE=true

# PostgreSQL credentials (used by both the db container and the backend)
POSTGRES_USER=briefai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=briefai
